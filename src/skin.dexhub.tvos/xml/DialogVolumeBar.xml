			<animation effect="fade" start="0" end="100" time="300">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="300">WindowClose</animation>
		</control>
		<control type="group">
			<height>80</height>
			<centerbottom>105</centerbottom>
			<right>60</right>
			<width>720</width>
			<animation effect="slide" start="0" end="0,-70" time="300" tween="sine" easing="inout" condition="Window.IsActive(DialogSeekBar.xml) + [Window.IsActive(VideoFullScreen.xml) | Window.IsActive(MusicVisualisation.xml)] + ![Window.IsVisible(DialogSubtitles.xml) | Window.IsVisible(DialogSettings.xml) | Window.IsVisible(DialogSelect.xml) | Window.IsVisible(DialogPlayerProcessInfo.xml) | Window.IsVisible(FileBrowser.xml) | Window.IsVisible(DialogContextMenu.xml) | Window.IsVisible(DialogSlider.xml)]">Conditional</animation>
			<animation effect="slide" start="0" end="0,-80" time="300" tween="sine" easing="inout" condition="[Window.IsVisible(videoosd) | Window.ISVisible(musicosd)] + [Window.IsActive(VideoFullScreen.xml) | Window.IsActive(MusicVisualisation.xml)] + ![Window.IsVisible(DialogSubtitles.xml) | Window.IsVisible(DialogSettings.xml) | Window.IsVisible(DialogSelect.xml) | Window.IsVisible(DialogPlayerProcessInfo.xml) | Window.IsVisible(FileBrowser.xml) | Window.IsVisible(DialogContextMenu.xml) | Window.IsVisible(DialogSlider.xml)]">Conditional</animation>
			<animation type="Visible" reversible="false" condition="![Window.IsActive(DialogExtendedProgressBar.xml) | Window.IsActive(DialogNotification.xml) | Window.IsActive(DialogBusy.xml)]">
