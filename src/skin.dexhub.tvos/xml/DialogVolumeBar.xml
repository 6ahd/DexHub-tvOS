			</animation>
			<control type="group">
				<description>Busy animation</description>
				<width>50</width>
				<height>50</height>
				<centertop>50%</centertop>
				<right>15</right>
				<control type="group">
					<control type="group">
						<centertop>50%</centertop>
						<width>50</width>
						<height>50</height>
						<centerleft>50%</centerleft>
						<control type="image">
							<left>-40</left>
							<right>-40</right>
							<top>-40</top>
							<bottom>-40</bottom>
							<bordersize>40</bordersize>
