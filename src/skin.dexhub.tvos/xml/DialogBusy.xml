<?xml version="1.0" encoding="UTF-8"?>
<window>
	<zorder>1000</zorder>
	<controls>
		<control type="image">
			<right>0</right>
			<bottom>0</bottom>
			<width>1500</width>
			<height>360</height>
			<texture>dexhub/corner_shade.png</texture>
			<!-- v3.27.3: nothing shows while a Dex Hub preview opens (Kodi opens
			     this dialog with every playback start; Dex Hub closes it at once:
			     the shade and spinner flashed before each trailer) -->
			<visible>String.IsEmpty(Window(Home).Property(dhs.preview.opening))</visible>
			<animation effect="fade" start="0" end="100" time="300">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="300">WindowClose</animation>
		</control>
		<control type="group">
			<visible>[!Window.IsActive(DialogExtendedProgressBar.xml) | Window.IsActive(fullscreenvideo) | Window.IsActive(visualisation)] + [!Window.IsActive(DialogVolumeBar.xml) | Player.Muted] + String.IsEmpty(Window(Home).Property(dhs.preview.opening))</visible>
			<height>80</height>
			<centerbottom>105</centerbottom>
			<right>60</right>
			<width>720</width>
			<animation effect="slide" start="0" end="0,-70" time="300" tween="sine" easing="inout" condition="Window.IsActive(DialogSeekBar.xml) + [Window.IsActive(VideoFullScreen.xml) | Window.IsActive(MusicVisualisation.xml)] + ![Window.IsVisible(DialogSubtitles.xml) | Window.IsVisible(DialogSettings.xml) | Window.IsVisible(DialogSelect.xml) | Window.IsVisible(DialogPlayerProcessInfo.xml) | Window.IsVisible(FileBrowser.xml) | Window.IsVisible(DialogContextMenu.xml) | Window.IsVisible(DialogSlider.xml)]">Conditional</animation>
			<animation effect="slide" start="0" end="0,-80" time="300" tween="sine" easing="inout" condition="[Window.IsVisible(videoosd) | Window.ISVisible(musicosd)] + [Window.IsActive(VideoFullScreen.xml) | Window.IsActive(MusicVisualisation.xml)] + ![Window.IsVisible(DialogSubtitles.xml) | Window.IsVisible(DialogSettings.xml) | Window.IsVisible(DialogSelect.xml) | Window.IsVisible(DialogPlayerProcessInfo.xml) | Window.IsVisible(FileBrowser.xml) | Window.IsVisible(DialogContextMenu.xml) | Window.IsVisible(DialogSlider.xml)]">Conditional</animation>
			<animation type="Visible" reversible="false" condition="![Window.IsActive(DialogExtendedProgressBar.xml) | Window.IsActive(DialogNotification.xml) | Window.IsActive(DialogVolumeBar.xml)]">
				<effect type="fade" start="0" end="100" time="300" delay=""/>
				<effect type="slide" start="0,48" end="0" center="auto" tween="back" easing="out" time="400" delay=""/>
			</animation>
			<animation type="WindowOpen" reversible="false" condition="![Window.IsActive(DialogExtendedProgressBar.xml) | Window.IsActive(DialogNotification.xml) | Window.IsActive(DialogVolumeBar.xml)]">
				<effect type="fade" start="0" end="100" time="300" delay=""/>
				<effect type="slide" start="0,48" end="0" center="auto" tween="back" easing="out" time="400" delay=""/>
			</animation>
			<control type="group">
				<description>Busy animation</description>
				<width>50</width>
				<height>50</height>
				<centertop>50%</centertop>
				<right>15</right>
				<control type="group">
					<control type="group">
						<centertop>50%</centertop>
						<width>50</width>
						<height>50</height>
						<centerleft>50%</centerleft>
						<control type="image">
							<left>-40</left>
							<right>-40</right>
							<top>-40</top>
							<bottom>-40</bottom>
							<bordersize>40</bordersize>
							<bordertexture colordiffuse="af3_shadow_soft">af3/shadows/circle_provider.png</bordertexture>
							<texture colordiffuse="af3_main_fg_100">af3/diffuse/circle/provider_circle.png</texture>
						</control>
						<control type="image">
							<aspectratio>keep</aspectratio>
							<texture colordiffuse="af3_main_bg_90" diffuse="af3/diffuse/circle/provider_circle.png">af3/extras/icons/kodi.png</texture>
							<bordersize>0</bordersize>
						</control>
					</control>
					<control type="group">
						<centerleft>50%</centerleft>
						<centertop>50%</centertop>
						<width>100</width>
						<height>100</height>
						<control type="image">
							<bordersize>-4</bordersize>
							<description>Busy animation</description>
							<texture colordiffuse="ffffffff">af3/dialog/loading-spinner.png</texture>
							<aspectratio>keep</aspectratio>
							<animation effect="rotate" condition="true" start="0" end="360" loop="true" time="1000" center="auto">Conditional</animation>
						</control>
					</control>
				</control>
			</control>
		</control>
		<control type="progress" id="10">
			<top>-3840</top>
			<left>-3840</left>
			<width>1</width>
			<height>1</height>
			<texturefocus/>
			<texturenofocus/>
			<font/>
			<texturebg colordiffuse="2f5f5f5f" border="12,0,12,0">af3/progress/progress-nib.png</texturebg>
			<lefttexture/>
			<midtexture colordiffuse="ffffffff" border="12,0,12,0">af3/progress/progress-nib.png</midtexture>
			<righttexture/>
			<overlaytexture/>
		</control>
	</controls>
</window>
