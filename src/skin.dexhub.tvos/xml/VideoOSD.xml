<?xml version='1.0' encoding='UTF-8'?>
<!-- DhLegacyPlayer3 --><!-- DhLegacyPlayer4 -->
<!-- DhLegacyPlayer 3.28.50 (main) 3.28.52 (tvOS) -->
<window>
	<defaultcontrol always="true">6001</defaultcontrol>
	<onload condition="String.IsEqual(Window(Home).Property(dhs.osd.badge.style),custom)">RunPlugin(plugin://plugin.video.dexhub.tvos/?action=player_badges_publish)</onload>
	<animation effect="fade" start="0" end="100" time="300" delay="200" condition="Window.IsActive(DialogSeekBar.xml) | Window.IsVisible(1152)">WindowOpen</animation>
	<animation effect="fade" start="0" end="100" time="300" condition="![Window.IsActive(DialogSeekBar.xml) | Window.IsVisible(1152)]">WindowOpen</animation>
	<animation effect="fade" end="0" start="100" time="220">WindowClose</animation>
	<onload>SetProperty(UID,$ESCINFO[Player.Title]$INFO[Player.Time(ss)],1146)</onload>
	<onload>SetProperty(UID,$ESCINFO[Player.Title]$INFO[Player.Time(ss)],1147)</onload>
	<onunload>CancelAlarm(osd_timeout,true)</onunload>
	<controls>
		<!-- DhDesigns: Player buttons > Design (skin string DexHub.OsdDesign, read when the skin loads) -->
		<include condition="String.IsEqual(Skin.String(DexHub.OsdDesign),classic)">DhDesign_VideoOSD_Classic</include>
		<include condition="!String.IsEqual(Skin.String(DexHub.OsdDesign),classic)">DhDesign_VideoOSD_Legacy</include>
	</controls>
</window>
