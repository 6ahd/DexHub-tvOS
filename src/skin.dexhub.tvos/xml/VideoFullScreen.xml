				<aligny>center</aligny>
				<height>40</height>
				<align>left</align>
				<width>auto</width>
				<selectedcolor>af3_main_fg_70</selectedcolor>
				<focusedcolor>ff272727</focusedcolor>
				<disabledcolor>af3_main_fg_30</disabledcolor>
				<texturefocus border="40" colordiffuse="ffffffff">af3/common/menu.png</texturefocus>
				<pulseonselect>false</pulseonselect>
				<scrollsuffix> </scrollsuffix>
				<scrollspeed>40</scrollspeed>
			</control>
			<control type="button" id="11">
				<textcolor>af3_panel_fg_100</textcolor>
				<textoffsetx>10</textoffsetx>
				<font>af3_font_mini</font>
				<texturenofocus colordiffuse="af3_panel_bg_70">af3/common/white.png</texturenofocus>
				<aligny>center</aligny>
				<height>40</height>
				<align>left</align>
				<width>auto</width>
				<selectedcolor>af3_main_fg_70</selectedcolor>
				<focusedcolor>ff272727</focusedcolor>
				<disabledcolor>af3_main_fg_30</disabledcolor>
				<texturefocus border="40" colordiffuse="ffffffff">af3/common/menu.png</texturefocus>
				<pulseonselect>false</pulseonselect>
				<scrollsuffix> </scrollsuffix>
				<scrollspeed>40</scrollspeed>
			</control>
			<control type="button" id="12">
				<textcolor>af3_panel_fg_100</textcolor>
				<textoffsetx>10</textoffsetx>
				<font>af3_font_mini</font>
				<texturenofocus colordiffuse="af3_panel_bg_70">af3/common/white.png</texturenofocus>
				<aligny>center</aligny>
				<height>40</height>
				<align>left</align>
				<width>auto</width>
				<selectedcolor>af3_main_fg_70</selectedcolor>
				<focusedcolor>ff272727</focusedcolor>
				<disabledcolor>af3_main_fg_30</disabledcolor>
				<texturefocus border="40" colordiffuse="ffffffff">af3/common/menu.png</texturefocus>
				<pulseonselect>false</pulseonselect>
				<scrollsuffix> </scrollsuffix>
				<scrollspeed>40</scrollspeed>
			</control>
			<scrolltime tween="quadratic">400</scrolltime>
			<usecontrolcoords>true</usecontrolcoords>
			<itemgap>0</itemgap>
		</control>
		<!-- 3.28.65 (GitHub #21): IMDb's Parents Guide for a few seconds when a video starts -->
		<control type="group">
			<left>56</left>
			<top>48</top>
			<visible>!String.IsEmpty(Window(Home).Property(dhs.pg.overlay)) + !Window.IsVisible(videoosd) + !Window.IsVisible(seekbar)</visible>
			<animation effect="fade" start="0" end="100" time="450">Visible</animation>
			<animation effect="slide" start="-40,0" end="0,0" time="450" tween="cubic" easing="out">Visible</animation>
