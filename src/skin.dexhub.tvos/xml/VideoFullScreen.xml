<?xml version='1.0' encoding='UTF-8'?>
<window>
	<onload condition="!String.IsEmpty(Window(Home).Property(TinyPPI.Running)) + !Window.IsVisible(script-tinyppi-main.xml) + !Window.IsVisible(script-tinyppi-dialog.xml) + !Window.IsVisible(script-tinyppi-dialog-single.xml) + !Window.IsVisible(script-tinyppi-dialog-bar.xml) + !Window.IsVisible(script-tinyppi-dv-metadata.xml)">ClearProperty(TinyPPI.Running,home)</onload>
	<onload condition="!String.IsEmpty(Window(Home).Property(TinyPPI.Active)) + !Window.IsVisible(script-tinyppi-main.xml) + !Window.IsVisible(script-tinyppi-dialog.xml) + !Window.IsVisible(script-tinyppi-dialog-single.xml) + !Window.IsVisible(script-tinyppi-dialog-bar.xml) + !Window.IsVisible(script-tinyppi-dv-metadata.xml)">ClearProperty(TinyPPI.Active,home)</onload>
