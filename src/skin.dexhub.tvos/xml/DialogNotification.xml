<?xml version="1.0" encoding="UTF-8"?>
<window>
	<zorder>1000</zorder>
	<controls>
		<control type="image">
			<right>0</right>
			<bottom>0</bottom>
			<width>1500</width>
			<height>360</height>
			<texture>dexhub/corner_shade.png</texture>
			<animation effect="fade" start="0" end="100" time="300">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="300">WindowClose</animation>
		</control>
		<control type="group">
			<height>80</height>
			<centerbottom>105</centerbottom>
			<right>60</right>
			<width>720</width>
			<animation effect="slide" start="0" end="0,-70" time="300" tween="sine" easing="inout" condition="Window.IsActive(DialogSeekBar.xml) + [Window.IsActive(VideoFullScreen.xml) | Window.IsActive(MusicVisualisation.xml)] + ![Window.IsVisible(DialogSubtitles.xml) | Window.IsVisible(DialogSettings.xml) | Window.IsVisible(DialogSelect.xml) | Window.IsVisible(DialogPlayerProcessInfo.xml) | Window.IsVisible(FileBrowser.xml) | Window.IsVisible(DialogContextMenu.xml) | Window.IsVisible(DialogSlider.xml)]">Conditional</animation>
			<animation effect="slide" start="0" end="0,-80" time="300" tween="sine" easing="inout" condition="[Window.IsVisible(videoosd) | Window.ISVisible(musicosd)] + [Window.IsActive(VideoFullScreen.xml) | Window.IsActive(MusicVisualisation.xml)] + ![Window.IsVisible(DialogSubtitles.xml) | Window.IsVisible(DialogSettings.xml) | Window.IsVisible(DialogSelect.xml) | Window.IsVisible(DialogPlayerProcessInfo.xml) | Window.IsVisible(FileBrowser.xml) | Window.IsVisible(DialogContextMenu.xml) | Window.IsVisible(DialogSlider.xml)]">Conditional</animation>
			<animation type="Visible" reversible="false" condition="![Window.IsActive(DialogExtendedProgressBar.xml) | Window.IsActive(DialogBusy.xml) | Window.IsActive(DialogVolumeBar.xml)]">
				<effect type="fade" start="0" end="100" time="300" delay=""/>
				<effect type="slide" start="0,48" end="0" center="auto" tween="back" easing="out" time="400" delay=""/>
			</animation>
			<animation type="WindowOpen" reversible="false" condition="![Window.IsActive(DialogExtendedProgressBar.xml) | Window.IsActive(DialogBusy.xml) | Window.IsActive(DialogVolumeBar.xml)]">
				<effect type="fade" start="0" end="100" time="300" delay=""/>
				<effect type="slide" start="0,48" end="0" center="auto" tween="back" easing="out" time="400" delay=""/>
			</animation>
			<control type="group">
				<top>25</top>
				<height>40</height>
				<right>100</right>
				<control type="grouplist">
					<orientation>horizontal</orientation>
					<align>right</align>
					<itemgap>8</itemgap>
					<control type="image">
						<height>1</height>
						<centerbottom>10</centerbottom>
						<width>320</width>
						<right>0</right>
						<texture colordiffuse="af3_main_fg_12" flipx="false">af3/common/gradient-box.png</texture>
					</control>
					<control type="label">
						<font>af3_font_hint_bold</font>
						<textcolor>af3_main_fg_100</textcolor>
						<shadowcolor>af3_main_bg_30</shadowcolor>
						<label>$INFO[Control.GetLabel(402)]</label>
						<width>auto</width>
						<align>right</align>
						<height>40</height>
						<centertop>30</centertop>
						<aligny>center</aligny>
						<selectedcolor>af3_main_fg_70</selectedcolor>
						<scrollsuffix> </scrollsuffix>
						<scrollspeed>40</scrollspeed>
						<disabledcolor>60FFFFFF</disabledcolor>
					</control>
					<scrolltime tween="quadratic">400</scrolltime>
					<usecontrolcoords>true</usecontrolcoords>
				</control>
				<control type="label">
					<height>40</height>
					<centertop>0</centertop>
					<font>af3_font_main_bold</font>
					<textcolor>af3_main_fg_90</textcolor>
					<shadowcolor>af3_main_bg_30</shadowcolor>
					<label>$INFO[Control.GetLabel(401)]</label>
					<align>right</align>
					<aligny>center</aligny>
					<selectedcolor>af3_main_fg_70</selectedcolor>
					<scrollsuffix> </scrollsuffix>
					<scrollspeed>40</scrollspeed>
					<disabledcolor>60FFFFFF</disabledcolor>
				</control>
			</control>
			<control type="group">
				<description>Busy animation</description>
				<width>50</width>
				<height>50</height>
				<centertop>50%</centertop>
				<right>15</right>
				<control type="group">
					<control type="group">
						<centerleft>50%</centerleft>
						<centertop>50%</centertop>
						<width>100</width>
						<height>100</height>
					</control>
				</control>
			</control>
			<control type="group">
				<centertop>50%</centertop>
				<width>50</width>
				<height>50</height>
				<right>15</right>
				<visible>String.StartsWith(Control.GetLabel(400),Default)</visible>
				<control type="image">
					<left>-40</left>
					<right>-40</right>
					<top>-40</top>
					<bottom>-40</bottom>
					<bordersize>40</bordersize>
					<bordertexture colordiffuse="af3_shadow_soft">af3/shadows/circle_provider.png</bordertexture>
					<texture colordiffuse="af3_main_fg_100">af3/diffuse/circle/provider_circle.png</texture>
				</control>
				<control type="image">
					<aspectratio>keep</aspectratio>
					<texture colordiffuse="af3_main_bg_90" diffuse="af3/diffuse/circle/provider_circle.png">af3/extras/icons/comment-dots.png</texture>
					<bordersize>0</bordersize>
				</control>
			</control>
			<control type="group">
				<centertop>50%</centertop>
				<width>50</width>
				<height>50</height>
				<right>15</right>
				<visible>!String.StartsWith(Control.GetLabel(400),Default)</visible>
				<control type="image">
					<left>-40</left>
					<right>-40</right>
					<top>-40</top>
					<bottom>-40</bottom>
					<bordersize>40</bordersize>
					<bordertexture colordiffuse="af3_shadow_soft">af3/shadows/circle_provider.png</bordertexture>
					<texture colordiffuse="af3_main_fg_100">af3/diffuse/circle/provider_circle.png</texture>
				</control>
				<control type="image">
					<aspectratio>keep</aspectratio>
					<texture colordiffuse="white" diffuse="af3/diffuse/circle/provider_circle.png">$INFO[Control.GetLabel(400)]</texture>
					<bordersize>2</bordersize>
				</control>
			</control>
		</control>
		<control type="image" id="400">
			<top>-3840</top>
			<left>-3840</left>
			<width>1</width>
			<height>1</height>
		</control>
		<control type="label" id="401">
			<top>-3840</top>
			<left>-3840</left>
			<width>1</width>
			<height>1</height>
			<align>left</align>
			<aligny>center</aligny>
			<font>af3_font_main</font>
			<textcolor>af3_main_fg_70</textcolor>
			<selectedcolor>af3_main_fg_70</selectedcolor>
			<scrollsuffix> </scrollsuffix>
			<scrollspeed>40</scrollspeed>
			<disabledcolor>60FFFFFF</disabledcolor>
		</control>
		<control type="label" id="402">
			<top>-3840</top>
			<left>-3840</left>
			<width>1</width>
			<height>1</height>
			<align>left</align>
			<aligny>center</aligny>
			<font>af3_font_main</font>
			<textcolor>af3_main_fg_70</textcolor>
			<selectedcolor>af3_main_fg_70</selectedcolor>
			<scrollsuffix> </scrollsuffix>
			<scrollspeed>40</scrollspeed>
			<disabledcolor>60FFFFFF</disabledcolor>
		</control>
	</controls>
</window>
