<?xml version='1.0' encoding='UTF-8'?>
<window id="11">
	<defaultcontrol always="true">8</defaultcontrol>
	<controls>
		<control type="image">
			<description>Dex Hub: the theme's surface</description>
			<texture colordiffuse="$VAR[DhSurface]">dexhub/white.png</texture>
		</control>
		<control type="image">
			<description>the accent's glow</description>
			<texture colordiffuse="$VAR[DhGlowA]">dexhub/page_glow_a.png</texture>
		<visible>!String.IsEqual(Skin.String(dh.glow),off)</visible></control>
		<control type="image">
			<texture colordiffuse="$VAR[DhGlowB]">dexhub/page_glow_b.png</texture>
		<visible>!String.IsEqual(Skin.String(dh.glow),off)</visible></control>
		<control type="group">
			<visible>Player.HasVideo + String.IsEmpty(Window(Home).Property(dexhub.trailer.active))</visible>
			<control type="videowindow"/>
			<control type="image">
				<texture colordiffuse="D9000000">dexhub/white.png</texture>
			</control>
		</control>
		<control type="mover" id="8">
			<description>top left mover</description>
			<left>0</left>
			<top>0</top>
			<width>128</width>
			<height>128</height>
			<texturefocus colordiffuse="ffffffff">af3/calibrate/cal_tl.png</texturefocus>
			<texturenofocus colordiffuse="af3_main_fg_100">af3/calibrate/cal_tl.png</texturenofocus>
			<movingspeed acceleration="180" maxvelocity="300" resettimeout="200" delta="1">
				<eventconfig type="up"/>
				<eventconfig type="down"/>
				<eventconfig type="left"/>
				<eventconfig type="right"/>
			</movingspeed>
		</control>
		<control type="mover" id="9">
			<description>right bottom mover</description>
			<left>700</left>
			<top>500</top>
			<width>128</width>
			<height>128</height>
			<texturefocus colordiffuse="ffffffff">af3/calibrate/cal_br.png</texturefocus>
			<texturenofocus colordiffuse="af3_main_fg_100">af3/calibrate/cal_br.png</texturenofocus>
			<movingspeed acceleration="180" maxvelocity="300" resettimeout="200" delta="1">
				<eventconfig type="up"/>
				<eventconfig type="down"/>
				<eventconfig type="left"/>
				<eventconfig type="right"/>
			</movingspeed>
		</control>
		<control type="resize" id="11">
			<description>pixel aspect ratio</description>
			<left>0</left>
			<top>390</top>
			<width>500</width>
			<height>500</height>
			<texturefocus colordiffuse="ffffffff">af3/calibrate/cal_ratio.png</texturefocus>
			<texturenofocus colordiffuse="af3_main_fg_100">af3/calibrate/cal_ratio.png</texturenofocus>
			<movingspeed acceleration="140" maxvelocity="300" resettimeout="180" delta="1">
				<eventconfig type="left"/>
				<eventconfig type="right"/>
			</movingspeed>
		</control>
		<control type="mover" id="10">
			<description>subtitle position mover</description>
			<left>200</left>
			<top>500</top>
			<width>380</width>
			<height>90</height>
			<texturefocus colordiffuse="ffffffff">af3/calibrate/cal_sub.png</texturefocus>
			<texturenofocus colordiffuse="af3_main_fg_100">af3/calibrate/cal_sub.png</texturenofocus>
			<movingspeed acceleration="180" maxvelocity="300" resettimeout="200" delta="1">
				<eventconfig type="up"/>
				<eventconfig type="down"/>
			</movingspeed>
		</control>
		<control type="mover" id="12">
			<description>reset calibration</description>
			<left>0</left>
			<top>900</top>
			<width>100</width>
			<height>100</height>
			<texturefocus colordiffuse="ffffffff">af3/calibrate/reset.png</texturefocus>
			<texturenofocus colordiffuse="af3_main_fg_100">af3/calibrate/reset.png</texturenofocus>
		</control>
		<control type="group">
			<top>80</top>
			<bottom>180</bottom>
			<control type="label">
				<description>window title</description>
				<height>40</height>
				<align>center</align>
				<label>$LOCALIZE[214]</label>
				<font>af3_font_head_bold</font>
				<textcolor>af3_main_fg_100</textcolor>
				<aligny>center</aligny>
				<selectedcolor>af3_main_fg_70</selectedcolor>
				<scrollsuffix> </scrollsuffix>
				<scrollspeed>40</scrollspeed>
				<disabledcolor>60FFFFFF</disabledcolor>
			</control>
			<control type="label" id="2">
				<description>resolution info</description>
				<top>40</top>
				<height>40</height>
				<align>center</align>
				<font>af3_font_main</font>
				<aligny>center</aligny>
				<textcolor>af3_main_fg_70</textcolor>
				<selectedcolor>af3_main_fg_70</selectedcolor>
				<scrollsuffix> </scrollsuffix>
				<scrollspeed>40</scrollspeed>
				<disabledcolor>60FFFFFF</disabledcolor>
			</control>
			<control type="label" id="3">
				<description>control description and help</description>
				<top>120</top>
				<height>40</height>
				<align>center</align>
				<font>af3_font_main</font>
				<textcolor>af3_main_fg_90</textcolor>
				<aligny>center</aligny>
				<selectedcolor>af3_main_fg_70</selectedcolor>
				<scrollsuffix> </scrollsuffix>
				<scrollspeed>40</scrollspeed>
				<disabledcolor>60FFFFFF</disabledcolor>
			</control>
			<control type="label" id="4">
				<description>calibration value</description>
				<bottom>0</bottom>
				<height>40</height>
				<align>center</align>
				<font>af3_font_main</font>
				<aligny>center</aligny>
				<textcolor>af3_main_fg_70</textcolor>
				<selectedcolor>af3_main_fg_70</selectedcolor>
				<scrollsuffix> </scrollsuffix>
				<scrollspeed>40</scrollspeed>
				<disabledcolor>60FFFFFF</disabledcolor>
			</control>
		</control>
	</controls>
</window>