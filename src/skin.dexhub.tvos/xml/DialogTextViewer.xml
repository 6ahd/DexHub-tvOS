<?xml version="1.0" encoding="UTF-8"?>
<window>
	<defaultcontrol always="true">61</defaultcontrol>
	<controls>
		<control type="image">
			<animation effect="fade" start="0" end="100" delay="0" time="400" tween="sine" easing="in" reversible="false" condition="true">Visible</animation>
			<animation effect="fade" start="0" end="100" delay="0" time="400" tween="sine" easing="in" reversible="false" condition="true">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" delay="0" time="300" tween="sine" easing="in" reversible="false" condition="true">Hidden</animation>
			<animation effect="fade" start="100" end="0" delay="0" time="300" tween="sine" easing="in" reversible="false" condition="true">WindowClose</animation>
			<texture colordiffuse="af3_shadow_back">af3/common/white.png</texture>
		</control>
		<control type="group">
			<width>1280</width>
			<centerleft>50%</centerleft>
			<top>100</top>
			<bottom>100</bottom>
			<animation type="Visible" reversible="false" condition="true">
				<effect type="fade" start="0" end="100" time="300" delay="200"/>
				<effect type="slide" start="0,-80" end="0" center="auto" tween="back" easing="out" time="600" delay="200"/>
			</animation>
			<animation type="WindowOpen" reversible="false" condition="true">
				<effect type="fade" start="0" end="100" time="300" delay="200"/>
				<effect type="slide" start="0,-80" end="0" center="auto" tween="back" easing="out" time="600" delay="200"/>
			</animation>
			<animation type="Hidden" reversible="false" condition="true">
				<effect type="zoom" start="100" end="95" center="auto" tween="sine" delay="0" easing="out" time="300"/>
				<effect type="fade" start="100" end="0" tween="cubic" easing="out" delay="0" time="300"/>
			</animation>
			<animation type="WindowClose" reversible="false" condition="true">
				<effect type="zoom" start="100" end="95" center="auto" tween="sine" delay="0" easing="out" time="300"/>
				<effect type="fade" start="100" end="0" tween="cubic" easing="out" delay="0" time="300"/>
			</animation>
			<control type="group">
				<control type="group">
					<left>40</left>
					<right>40</right>
					<top>40</top>
					<bottom>40</bottom>
					<control type="group">
						<control type="group">
							<control type="image">
								<texture colordiffuse="af3_dialog_bg_100" border="20">af3/common/dialog.png</texture>
								<left>-80</left>
								<right>-80</right>
								<top>-80</top>
								<bottom>-80</bottom>
								<bordersize>80</bordersize>
								<bordertexture border="100" colordiffuse="af3_shadow_hard">af3/shadows/shadow-80.png</bordertexture>
							</control>
							<control type="image">
								<fadetime>400</fadetime>
								<texture border="40" colordiffuse="af3_overlay_hard">$VAR[AF3P_Image_Current_Background,,-diffuse-20.jpg]</texture>
							</control>
						</control>
						<control type="image">
							<texture colordiffuse="af3_dialog_fg_06" border="20">af3/common/dialog-outline.png</texture>
						</control>
					</control>
					<control type="image">
						<texture colordiffuse="af3_dialog_fg_06" border="20">af3/common/dialog.png</texture>
					</control>
				</control>
				<control type="group">
					<right>80</right>
					<left>80</left>
				</control>
			</control>
			<control type="group" id="8000">
				<left>40</left>
				<right>40</right>
				<top>40</top>
				<bottom>40</bottom>
				<control type="group">
					<height>120</height>
					<control type="group">
						<right>120</right>
						<height>40</height>
						<top>40</top>
						<left>40</left>
						<control type="label" id="1">
							<label></label>
							<font>af3_font_midi_bold</font>
							<textcolor>af3_dialog_fg_90</textcolor>
							<height>40</height>
							<centertop>50%</centertop>
							<align>left</align>
							<aligny>center</aligny>
							<selectedcolor>af3_main_fg_70</selectedcolor>
							<scrollsuffix> </scrollsuffix>
							<scrollspeed>40</scrollspeed>
							<disabledcolor>60FFFFFF</disabledcolor>
						</control>
					</control>
					<control type="image">
						<height>1</height>
						<texture colordiffuse="af3_dialog_fg_06">af3/common/white.png</texture>
						<centerbottom>0</centerbottom>
						<left>40</left>
						<right>40</right>
					</control>
					<control type="group">
						<centerright>60</centerright>
						<centertop>50%</centertop>
						<height>80</height>
						<width>80</width>
						<control type="button" id="90001">
							<texturefocus colordiffuse="ffffffff">af3/common/circle.png</texturefocus>
							<texturenofocus/>
							<onclick>Close</onclick>
							<onleft></onleft>
							<onright></onright>
							<onup></onup>
							<ondown></ondown>
							<oninfo></oninfo>
							<onback></onback>
							<align>center</align>
							<aligny>center</aligny>
							<font>af3_font_mini</font>
							<textoffsetx>30</textoffsetx>
							<textcolor>af3_main_fg_70</textcolor>
							<selectedcolor>af3_main_fg_70</selectedcolor>
							<focusedcolor>ff272727</focusedcolor>
							<disabledcolor>af3_main_fg_30</disabledcolor>
							<pulseonselect>false</pulseonselect>
							<scrollsuffix> </scrollsuffix>
							<scrollspeed>40</scrollspeed>
						</control>
						<control type="group" id="90101">
							<animation effect="fade" start="100" end="30" condition="!Control.IsEnabled(90001)" reversible="false">Conditional</animation>
							<left>80</left>
							<width>0</width>
							<control type="group">
								<left>-80</left>
								<control type="image">
									<bordersize>12</bordersize>
									<height>80</height>
									<width>80</width>
									<texture colordiffuse="af3_dialog_fg_70" flipx="false">af3/extras/icons/xmark.png</texture>
									<visible>!Control.HasFocus(90001)</visible>
								</control>
								<control type="image">
									<bordersize>12</bordersize>
									<height>80</height>
									<width>80</width>
									<texture colordiffuse="ff272727" flipx="false">af3/extras/icons/xmark.png</texture>
									<visible>Control.HasFocus(90001)</visible>
								</control>
							</control>
						</control>
					</control>
				</control>
				<control type="group">
					<top>120</top>
					<control type="group">
						<control type="textbox" id="5">
							<font>af3_font_midi_plot</font>
							<textcolor>af3_dialog_fg_70</textcolor>
							<pagecontrol>61</pagecontrol>
							<label></label>
							<autoscroll>false</autoscroll>
							<top>32</top>
							<bottom>30</bottom>
							<right>40</right>
							<left>40</left>
							<align>left</align>
							<selectedcolor>af3_main_fg_70</selectedcolor>
						</control>
						<control type="scrollbar" id="61">
							<top>20</top>
							<bottom>20</bottom>
							<centerright>0</centerright>
							<width>10</width>
							<showonepage>false</showonepage>
							<texturesliderbackground/>
							<texturesliderbar colordiffuse="af3_dialog_fg_70" border="4">af3/scrollbar/scrollv_line.png</texturesliderbar>
							<texturesliderbarfocus border="4" colordiffuse="ffffffff">af3/common/scrollv.png</texturesliderbarfocus>
							<textureslidernib/>
							<textureslidernibfocus/>
							<orientation>vertical</orientation>
						</control>
					</control>
				</control>
			</control>
		</control>
	</controls>
</window>
