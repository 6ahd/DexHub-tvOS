										<selectedcolor>af3_main_fg_70</selectedcolor>
										<scrollsuffix> </scrollsuffix>
										<scrollspeed>40</scrollspeed>
										<disabledcolor>60FFFFFF</disabledcolor>
									</control>
									<control type="image">
										<height>1</height>
										<texture colordiffuse="af3_dialog_fg_06">af3/common/white.png</texture>
										<centertop>50%</centertop>
										<width>2000</width>
									</control>
									<scrolltime tween="quadratic">400</scrolltime>
									<usecontrolcoords>true</usecontrolcoords>
								</control>
							</control>
							<control type="grouplist" id="996">
								<pagecontrol>61</pagecontrol>
								<onright>61</onright>
								<left>20</left>
								<right>20</right>
								<top>20</top>
								<bottom>20</bottom>
								<scrolltime tween="quadratic">400</scrolltime>
								<usecontrolcoords>true</usecontrolcoords>
								<itemgap>0</itemgap>
							</control>
							<control type="scrollbar" id="61">
								<onright>6000</onright>
								<onleft>996</onleft>
								<top>20</top>
								<bottom>20</bottom>
								<centerright>0</centerright>
								<width>10</width>
								<showonepage>false</showonepage>
								<texturesliderbackground/>
