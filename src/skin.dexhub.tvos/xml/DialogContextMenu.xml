			<textcolor>af3_dialog_fg_70</textcolor>
			<selectedcolor>af3_dialog_fg_70</selectedcolor>
			<disabledcolor>af3_dialog_fg_30</disabledcolor>
			<description>None</description>
			<aligny>center</aligny>
			<focusedcolor>ff272727</focusedcolor>
			<texturefocus border="40" colordiffuse="ffffffff">af3/common/menu.png</texturefocus>
			<pulseonselect>false</pulseonselect>
			<scrollsuffix> </scrollsuffix>
			<scrollspeed>40</scrollspeed>
		</control>
	</controls>
</window>
