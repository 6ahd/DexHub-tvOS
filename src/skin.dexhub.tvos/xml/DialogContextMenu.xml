								</control>
							</control>
						</control>
					</control>
					<control type="group">
						<top>120</top>
						<control type="group">
							<control type="group">
								<top>-120</top>
								<height>40</height>
								<control type="grouplist">
									<height>20</height>
									<left>40</left>
									<right>40</right>
									<centertop>120</centertop>
									<orientation>horizontal</orientation>
									<itemgap>20</itemgap>
									<align>left</align>
									<visible>Control.IsVisible(996)</visible>
									<control type="label" id="">
										<width>auto</width>
										<aligny>center</aligny>
										<align>left</align>
										<font>af3_font_hint_bold</font>
										<textcolor>af3_dialog_fg_30</textcolor>
