<?xml version="1.0" encoding="UTF-8"?>
<window>
	<defaultcontrol always="true">11</defaultcontrol>
	<onload condition="System.HasAlarm(osd_timeout)">SetProperty(osd_timeout_DialogSlider.xml,true,home)</onload>
	<onload condition="System.HasAlarm(osd_timeout)">CancelAlarm(osd_timeout,true)</onload>
	<onunload condition="!String.IsEmpty(Window(Home).Property(osd_timeout_DialogSlider.xml))">ClearProperty(osd_timeout_DialogSlider.xml,home)</onunload>
	<controls>
		<control type="image">
			<animation effect="fade" start="0" end="100" delay="0" time="400" tween="sine" easing="in" reversible="false" condition="true">Visible</animation>
			<animation effect="fade" start="0" end="100" delay="0" time="400" tween="sine" easing="in" reversible="false" condition="true">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" delay="0" time="300" tween="sine" easing="in" reversible="false" condition="true">Hidden</animation>
			<animation effect="fade" start="100" end="0" delay="0" time="300" tween="sine" easing="in" reversible="false" condition="true">WindowClose</animation>
			<texture colordiffuse="af3_shadow_back">af3/common/white.png</texture>
		</control>
		<control type="group">
			<animation type="Visible" reversible="false" condition="true">
				<effect type="fade" start="0" end="100" time="300" delay="150"/>
				<effect type="slide" start="0,-48" end="0" center="auto" tween="back" easing="out" time="400" delay="150"/>
			</animation>
			<animation type="WindowOpen" reversible="false" condition="true">
				<effect type="fade" start="0" end="100" time="300" delay="400"/>
				<effect type="slide" start="0,-48" end="0" center="auto" tween="back" easing="out" time="400" delay="400"/>
			</animation>
			<top>40</top>
			<height>200</height>
			<width>960</width>
			<centerleft>50%</centerleft>
			<control type="group">
				<control type="group">
					<animation effect="fade" start="100" end="90" condition="true">Conditional</animation>
					<control type="image">
						<texture colordiffuse="af3_dialog_bg_100" border="20">af3/common/dialog.png</texture>
						<left>-80</left>
						<right>-80</right>
						<top>-80</top>
						<bottom>-80</bottom>
						<bordersize>80</bordersize>
						<bordertexture border="100" colordiffuse="af3_shadow_hard">af3/shadows/shadow-80.png</bordertexture>
					</control>
					<control type="image">
						<fadetime>400</fadetime>
						<texture border="40" colordiffuse="af3_overlay_hard">$VAR[AF3P_Image_Current_Background,,-diffuse-20.jpg]</texture>
					</control>
				</control>
				<control type="image">
					<texture colordiffuse="af3_dialog_fg_06" border="20">af3/common/dialog-outline.png</texture>
				</control>
				<control type="image">
					<texture colordiffuse="af3_panel_fg_12" border="20">af3/common/dialog.png</texture>
				</control>
			</control>
			<control type="group">
				<left>40</left>
				<right>40</right>
				<control type="group">
					<height>12</height>
					<centerbottom>60</centerbottom>
					<control type="image">
						<texture colordiffuse="af3_dialog_fg_06">af3/common/white.png</texture>
						<width>2</width>
						<height>8</height>
						<centerleft>12</centerleft>
						<top>-8</top>
					</control>
					<control type="image">
						<texture colordiffuse="af3_dialog_fg_06">af3/common/white.png</texture>
						<width>2</width>
						<height>8</height>
						<centerleft>12</centerleft>
						<bottom>-8</bottom>
					</control>
					<control type="image">
						<texture colordiffuse="af3_dialog_fg_06">af3/common/white.png</texture>
						<width>2</width>
						<height>8</height>
						<centerleft>25%</centerleft>
						<top>-8</top>
					</control>
					<control type="image">
						<texture colordiffuse="af3_dialog_fg_06">af3/common/white.png</texture>
						<width>2</width>
						<height>8</height>
						<centerleft>25%</centerleft>
						<bottom>-8</bottom>
					</control>
					<control type="image">
						<texture colordiffuse="af3_dialog_fg_06">af3/common/white.png</texture>
						<width>2</width>
						<height>12</height>
						<centerleft>50%</centerleft>
						<top>-12</top>
					</control>
					<control type="image">
						<texture colordiffuse="af3_dialog_fg_06">af3/common/white.png</texture>
						<width>2</width>
						<height>12</height>
						<centerleft>50%</centerleft>
						<bottom>-12</bottom>
					</control>
					<control type="image">
						<texture colordiffuse="af3_dialog_fg_06">af3/common/white.png</texture>
						<width>2</width>
						<height>8</height>
						<centerright>25%</centerright>
						<top>-8</top>
					</control>
					<control type="image">
						<texture colordiffuse="af3_dialog_fg_06">af3/common/white.png</texture>
						<width>2</width>
						<height>8</height>
						<centerright>25%</centerright>
						<bottom>-8</bottom>
					</control>
					<control type="image">
						<texture colordiffuse="af3_dialog_fg_06">af3/common/white.png</texture>
						<width>2</width>
						<height>8</height>
						<centerright>12</centerright>
						<top>-8</top>
					</control>
					<control type="image">
						<texture colordiffuse="af3_dialog_fg_06">af3/common/white.png</texture>
						<width>2</width>
						<height>8</height>
						<centerright>12</centerright>
						<bottom>-8</bottom>
					</control>
					<control type="slider" id="11">
						<texturesliderbar colordiffuse="af3_dialog_fg_06" border="6">af3/slider/slider_bg.png</texturesliderbar>
						<textureslidernib colordiffuse="af3_dialog_fg_30" border="6">af3/slider/slider_nib.png</textureslidernib>
						<textureslidernibfocus colordiffuse="ffffffff" border="6">af3/slider/slider_nib.png</textureslidernibfocus>
						<ondown>Close</ondown>
						<onup>Close</onup>
						<align>center</align>
						<aligny>center</aligny>
						<font>af3_font_mini</font>
						<textoffsetx>30</textoffsetx>
						<textcolor>af3_main_fg_70</textcolor>
						<focusedcolor>ff272727</focusedcolor>
						<disabledcolor>af3_main_fg_30</disabledcolor>
						<texturenofocus colordiffuse="af3_dialog_fg_06" border="40">af3/common/menu.png</texturenofocus>
						<texturefocus border="40" colordiffuse="ffffffff">af3/common/menu.png</texturefocus>
						<pulseonselect>false</pulseonselect>
						<sliderwidth>192</sliderwidth>
						<sliderheight>12</sliderheight>
						<orientation>horizontal</orientation>
						<scrollsuffix> </scrollsuffix>
						<scrollspeed>40</scrollspeed>
						<texturesliderbardisabled/>
						<textureslidernibdisabled/>
					</control>
				</control>
				<control type="group">
					<top>40</top>
					<height>40</height>
					<control type="label" id="10">
						<font>af3_font_midi_bold</font>
						<align>left</align>
						<textcolor>af3_dialog_fg_90</textcolor>
						<aligny>center</aligny>
						<selectedcolor>af3_main_fg_70</selectedcolor>
						<scrollsuffix> </scrollsuffix>
						<scrollspeed>40</scrollspeed>
						<disabledcolor>60FFFFFF</disabledcolor>
					</control>
					<control type="label" id="12">
						<font>af3_font_main</font>
						<align>right</align>
						<textcolor>af3_dialog_fg_90</textcolor>
						<aligny>center</aligny>
						<selectedcolor>af3_main_fg_70</selectedcolor>
						<scrollsuffix> </scrollsuffix>
						<scrollspeed>40</scrollspeed>
						<disabledcolor>60FFFFFF</disabledcolor>
					</control>
				</control>
			</control>
		</control>
	</controls>
</window>
